# FL Platform — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED: Secret key for JWT token signing. Minimum 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_in_production_at_least_32_chars

# ── Federated Learning Encryption ─────────────────────────────────────────────
# REQUIRED: Base64-encoded AES-256 key for weight encryption.
# Generate with: python -c "from shared.encryption import generate_key_b64; print(generate_key_b64())"
FL_ENCRYPTION_KEY=

# ── Network ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── ngrok Public Tunnel (optional) ────────────────────────────────────────────
# Set to expose the server over ngrok for distributed clients.
# Obtain at: https://dashboard.ngrok.com/auth
NGROK_AUTH_TOKEN=

# ── Phase 2A: PostgreSQL (optional — falls back to JSON flat-file) ─────────────
# Format: postgresql+psycopg2://user:password@host:port/dbname
# For Docker Compose: postgresql+psycopg2://fl_user:fl_pass@postgres:5432/fl_platform
DATABASE_URL=

# ── Phase 2A: Redis (optional — falls back to in-memory state) ────────────────
# Format: redis://host:port/db
REDIS_URL=

# ── Phase 2B: Celery Task Queue (optional — falls back to FastAPI BackgroundTask)
CELERY_BROKER_URL=
CELERY_RESULT_URL=

# ── Phase 2B: Celery Beat (stall recovery) ────────────────────────────────────
# Timeout (seconds) before a stuck round is marked ERROR. Default: 7200 (2h)
ROUND_STALL_TIMEOUT_S=7200

# ── Phase 2B: Model Storage (optional — falls back to local filesystem) ────────
# Set S3_BUCKET to enable S3-backed model checkpoint storage.
S3_BUCKET=
S3_PREFIX=fl-models/
# AWS credentials (or use IAM role / instance profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Directory for local model storage (default: server/models/)
MODELS_DIR=

# ── Phase 2C: OpenTelemetry (optional) ────────────────────────────────────────
# Set to enable distributed tracing (Jaeger, Honeycomb, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fl-platform-server

# ── Server-side Validation (optional) ─────────────────────────────────────────
# Path to a held-out CSV for server-side global model validation each round.
VAL_CSV_PATH=

# ── Phase 3: Differential Privacy ────────────────────────────────────────────
# Per-round privacy budget. Set > 0 to enable DP-SGD noise on client updates.
# Client reads this from the server's project config — set here for defaults.
DP_EPSILON=0.0
DP_DELTA=1e-5
DP_MAX_GRAD_NORM=1.0

# ── Phase 3: FLAME / Anomaly Defense ─────────────────────────────────────────
# Fraction of updates to trim per coordinate (coordinate-wise trimmed mean).
# 0.0 = standard FedAvg, 0.1 = trim top+bottom 10% per coordinate.
BYZANTINE_TRIMMING_RATIO=0.0

# ── Phase 3: Consent Management ───────────────────────────────────────────────
# Require explicit per-hospital consent record before accepting updates.
REQUIRE_CONSENT=false

# ── Phase 3: BAA Enforcement ──────────────────────────────────────────────────
# Require BAA to be signed before a hospital can participate in any project.
REQUIRE_BAA=false

# ── Phase 3: mTLS ─────────────────────────────────────────────────────────────
# Path to CA cert, server cert, and server key for mutual TLS.
MTLS_CA_CERT=
MTLS_SERVER_CERT=
MTLS_SERVER_KEY=
